rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Registrations collection: allow public read/write so attendees and Secretariat admin can view, verify and manage
    match /registrations/{registrationId} {
      allow read, list: if true;
      allow create: if isValidId(registrationId);
      allow update, delete: if true;
    }

    // Car Passes collection: allow public read/write so attendees and Secretariat admin can view, verify and manage
    match /car_passes/{carPassId} {
      allow read, list: if true;
      allow create: if isValidId(carPassId);
      allow update, delete: if true;
    }

    // Admin profiles: accessible by Secretariat dashboard
    match /admins/{adminId} {
      allow read, list, write: if true;
    }

    // Event Documents (PDF / DOCX): published and downloadable
    match /event_documents/{docId} {
      allow read, list, write: if true;
    }

    // Gallery Items: dynamic photo and video archive
    match /gallery_items/{itemId} {
      allow read, list, write: if true;
    }

    // Participant Feedback: attendee reviews
    match /feedback/{feedbackId} {
      allow read, list, write: if true;
    }

    // Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
