{
  "entities": {
    "Registration": {
      "title": "Registration",
      "description": "Participant and delegation registration for Priti-Lagnik Maha Mahotsav 2026",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique registration ID",
          "maxLength": 64
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the delegate or delegation head",
          "maxLength": 128
        },
        "phone": {
          "type": "string",
          "description": "Mobile contact number",
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "description": "Email address",
          "maxLength": 128
        },
        "city": {
          "type": "string",
          "description": "City or district of the attendee",
          "maxLength": 100
        },
        "state": {
          "type": "string",
          "description": "State or region",
          "maxLength": 100
        },
        "delegationSize": {
          "type": "number",
          "description": "Number of people in delegation"
        },
        "arrivalDate": {
          "type": "string",
          "description": "Expected arrival date in YYYY-MM-DD",
          "maxLength": 32
        },
        "departureDate": {
          "type": "string",
          "description": "Expected departure date",
          "maxLength": 32
        },
        "needAccommodation": {
          "type": "boolean",
          "description": "Whether accommodation assistance is required"
        },
        "accommodationType": {
          "type": "string",
          "description": "Type of accommodation requested",
          "maxLength": 128
        },
        "foodPreference": {
          "type": "string",
          "description": "Satvik meal requirement",
          "maxLength": 64
        },
        "volunteerInterest": {
          "type": "boolean",
          "description": "Whether attendee wishes to volunteer for seva"
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional base64 image or avatar photo url for pass card printing",
          "maxLength": 500000
        },
        "status": {
          "type": "string",
          "description": "Status of the registration",
          "enum": ["pending", "accepted", "declined"],
          "maxLength": 32
        },
        "confirmationSent": {
          "type": "boolean",
          "description": "Whether WhatsApp or email confirmation message was sent"
        },
        "confirmedAt": {
          "type": "string",
          "description": "Timestamp when acceptance confirmation was sent",
          "maxLength": 64
        },
        "registeredAt": {
          "type": "string",
          "description": "Timestamp when registration was submitted",
          "maxLength": 64
        },
        "notes": {
          "type": "string",
          "description": "Admin notes or allocation details",
          "maxLength": 500
        }
      },
      "required": ["fullName", "phone", "city", "state", "delegationSize", "arrivalDate", "status"]
    },
    "CarPass": {
      "title": "CarPass",
      "description": "Official vehicle entry and parking pass for Priti-Lagnik Maha Mahotsav 2026",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique vehicle pass reference ID",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "description": "Name of the vehicle owner or organization",
          "maxLength": 128
        },
        "carRegistrationNumber": {
          "type": "string",
          "description": "Vehicle registration number plate",
          "maxLength": 64
        },
        "driverName": {
          "type": "string",
          "description": "Name of driver",
          "maxLength": 128
        },
        "driverPhone": {
          "type": "string",
          "description": "Driver mobile number",
          "maxLength": 32
        },
        "contactNumber": {
          "type": "string",
          "description": "Owner / Primary contact phone number",
          "maxLength": 32
        },
        "address": {
          "type": "string",
          "description": "Origin address / city / state",
          "maxLength": 200
        },
        "vehicleType": {
          "type": "string",
          "description": "Type of vehicle (Car/SUV/Van/Bus)",
          "maxLength": 64
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional photo of driver or vehicle",
          "maxLength": 500000
        },
        "status": {
          "type": "string",
          "description": "Status of car pass approval",
          "enum": ["pending", "accepted", "declined"],
          "maxLength": 32
        },
        "allocatedZone": {
          "type": "string",
          "description": "Allocated parking zone or bay at Dotma grounds",
          "maxLength": 100
        },
        "registeredAt": {
          "type": "string",
          "description": "Timestamp of car pass registration",
          "maxLength": 64
        },
        "confirmedAt": {
          "type": "string",
          "description": "Timestamp of acceptance",
          "maxLength": 64
        }
      },
      "required": ["name", "carRegistrationNumber", "driverName", "contactNumber", "address", "status"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Administrator account authorized to manage registrations and festival operations",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Role of the administrator",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp",
          "maxLength": 64
        }
      },
      "required": ["email", "role"]
    },
    "CommitteeMember": {
      "title": "CommitteeMember",
      "description": "Executive and organising committee member details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["name", "role", "category", "location"]
    },
    "OrganisingTeam": {
      "title": "OrganisingTeam",
      "description": "Volunteer team and operational cell",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lead": { "type": "string" },
        "volunteersCount": { "type": "number" },
        "responsibilities": { "type": "array" },
        "contactPerson": { "type": "string" },
        "contactNumber": { "type": "string" }
      },
      "required": ["name", "lead", "volunteersCount", "contactNumber"]
    },
    "Accommodation": {
      "title": "Accommodation",
      "description": "Lodging and hotel information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "distance": { "type": "string" },
        "location": { "type": "string" },
        "capacity": { "type": "string" },
        "tariff": { "type": "string" },
        "amenities": { "type": "array" },
        "contactName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "bookingStatus": { "type": "string" }
      },
      "required": ["name", "type", "location", "tariff", "phone"]
    },
    "VisitorStats": {
      "title": "VisitorStats",
      "description": "Daily and all-time aggregate visitor counter documents",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Date key in YYYY-MM-DD format for daily stats",
          "maxLength": 32
        },
        "count": {
          "type": "number",
          "description": "Visitor count for the specific day"
        },
        "totalCount": {
          "type": "number",
          "description": "All-time visitor count"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last counter update",
          "maxLength": 64
        }
      },
      "required": ["updatedAt"]
    },
    "VisitorLog": {
      "title": "VisitorLog",
      "description": "Detailed visitor telemetry persisted for administrative reference (not displayed publicly)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique visit record ID",
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "Visit date in YYYY-MM-DD (Asia/Kolkata)",
          "maxLength": 32
        },
        "userAgent": {
          "type": "string",
          "description": "Browser User-Agent string",
          "maxLength": 512
        },
        "ip": {
          "type": "string",
          "description": "Visitor public IP address",
          "maxLength": 64
        },
        "deviceType": {
          "type": "string",
          "description": "Device category (mobile or desktop)",
          "enum": ["mobile", "desktop"],
          "maxLength": 16
        },
        "mobileOs": {
          "type": "string",
          "description": "Mobile operating system if mobile (iOS, Android, Other, or N/A)",
          "enum": ["iOS", "Android", "Other", "N/A"],
          "maxLength": 16
        },
        "sessionEmails": {
          "type": "array",
          "description": "Emails associated with the visitor session, if any"
        },
        "primaryEmail": {
          "type": "string",
          "description": "Primary session email if available, or empty string",
          "maxLength": 128
        },
        "pagePath": {
          "type": "string",
          "description": "Visited URL path and hash",
          "maxLength": 256
        },
        "referrer": {
          "type": "string",
          "description": "Document referrer URL",
          "maxLength": 512
        },
        "visitedAt": {
          "type": "string",
          "description": "ISO timestamp of visit creation",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        }
      },
      "required": ["id", "date", "userAgent", "ip", "deviceType", "mobileOs", "sessionEmails", "primaryEmail", "visitedAt", "updatedAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Official notices and announcements managed by Secretariat Admin and shown in the home ticker and Notices page",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique notice identifier",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Notice headline / title",
          "maxLength": 160
        },
        "content": {
          "type": "string",
          "description": "Full notice and announcement body text",
          "maxLength": 5000
        },
        "category": {
          "type": "string",
          "description": "Announcement category",
          "enum": ["General", "Schedule", "Accommodation", "Transport", "Urgent", "Seva"],
          "maxLength": 32
        },
        "priority": {
          "type": "string",
          "description": "Urgency level",
          "enum": ["Normal", "Important", "Urgent"],
          "maxLength": 32
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the notice is published publicly"
        },
        "showInTicker": {
          "type": "boolean",
          "description": "Whether the notice appears in the Hero latest announcement ticker"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the notice is pinned to the top"
        },
        "linkUrl": {
          "type": "string",
          "description": "Optional external reference URL",
          "maxLength": 512
        },
        "createdBy": {
          "type": "string",
          "description": "Name or email of admin who created or updated the notice",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 64
        }
      },
      "required": ["id", "title", "content", "category", "priority", "isActive", "showInTicker", "isPinned", "linkUrl", "createdBy", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Public submissions and admin-managed records of festival attendees"
    },
    "/car_passes/{carPassId}": {
      "schema": "CarPass",
      "description": "Vehicle entry and parking pass applications and grants"
    },
    "/admins/{adminId}": {
      "schema": "AdminProfile",
      "description": "Administrative records allowing dashboard management"
    },
    "/committee_members/{memberId}": {
      "schema": "CommitteeMember",
      "description": "Committee members managed via admin panel"
    },
    "/organising_teams/{teamId}": {
      "schema": "OrganisingTeam",
      "description": "Organising volunteer teams managed via admin panel"
    },
    "/accommodations/{accId}": {
      "schema": "Accommodation",
      "description": "Hotels and stay options managed via admin panel"
    },
    "/visitor_stats/{statId}": {
      "schema": "VisitorStats",
      "description": "Daily (daily_YYYY-MM-DD) and all-time (all_time) visitor counts"
    },
    "/visitor_logs/{visitId}": {
      "schema": "VisitorLog",
      "description": "Visitor metadata logs (User Agent, IP, deviceType, mobileOs, sessionEmails)"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Official notices and announcements displayed in the ticker and About -> Notices & Announcements"
    }
  }
}
